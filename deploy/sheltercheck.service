[Unit]
Description=Signal shelter reaction tracker
After=network-online.target signal-cli.service
Wants=network-online.target
Requires=signal-cli.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=sheltercheck
Group=sheltercheck
WorkingDirectory=/var/lib/sheltercheck
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/sheltercheck/.venv/bin/python -m sheltercheck --config /etc/sheltercheck/config.toml --validate-config
ExecStart=/opt/sheltercheck/.venv/bin/python -m sheltercheck --config /etc/sheltercheck/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sheltercheck
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
