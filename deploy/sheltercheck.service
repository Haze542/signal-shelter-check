[Unit]
Description=Signal shelter reaction tracker
After=network-online.target signal-cli.service
Wants=network-online.target signal-cli.service
# A hard Requires= leaves this unit failed after signal-cli's first failed start,
# even if signal-cli later recovers via Restart=. ExecStartPre is the readiness gate.
StartLimitIntervalSec=0

[Service]
Type=simple
User=sheltercheck
Group=sheltercheck
WorkingDirectory=/var/lib/sheltercheck
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/sheltercheck/.venv/bin/python -m sheltercheck --config /etc/sheltercheck/config.toml --validate-config
ExecStartPre=/opt/sheltercheck/.venv/bin/python /opt/sheltercheck/signal_cli_readiness.py --url http://127.0.0.1:8080 --timeout-seconds 30
ExecStart=/opt/sheltercheck/.venv/bin/python -m sheltercheck --config /etc/sheltercheck/config.toml
Restart=on-failure
RestartSec=10
TimeoutStartSec=45
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sheltercheck
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
